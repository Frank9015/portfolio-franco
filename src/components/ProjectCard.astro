---
import type { ProjectData } from '../config/profile';

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
---

<div class="project-card glass-card">
  <div class="card-top">
    <div class="meta-row">
      <span class="category-badge">{project.category} · {project.year}</span>
      
      {project.status === 'Live' && (
        <span class="badge badge-live">
          <span class="pulse-dot"></span>
          Live en Vercel
        </span>
      )}

      {project.status === 'Interactive Sandbox' && (
        <span class="badge badge-sandbox">
          ⚡ Sandbox Interactivo
        </span>
      )}
    </div>

    <h3 class="project-title">{project.title}</h3>
    <h4 class="project-subtitle">{project.subtitle}</h4>
    <p class="project-summary">{project.summary}</p>

    <div class="highlights-box">
      <span class="highlights-label">Destacados de Ingeniería:</span>
      <ul>
        {project.highlights.slice(0, 3).map((hl) => (
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{hl}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="card-bottom">
    <div class="tech-stack">
      {project.techStack.map((tech) => (
        <span class="tech-pill">{tech.name}</span>
      ))}
    </div>

    <div class="card-actions">
      <a href={`/proyectos/${project.id}`} class="btn btn-primary btn-block">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Probar Demo Interactivo & Docs
      </a>

      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-cyan btn-icon" title="Abrir sitio web live">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}

      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-icon" title="Ver código en GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 2rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--cyan-light);
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid var(--border-cyan);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .project-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
    color: var(--text-main);
  }

  .project-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .project-summary {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .highlights-box {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .highlights-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--cyan-light);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .highlights-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .highlights-box li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .highlights-box li svg {
    color: var(--emerald-light);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-subtle);
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-block {
    flex: 1;
  }

  .btn-icon {
    padding: 0.85rem;
  }
</style>
