---
import { PROFILE_CONFIG } from '../config/profile';
---

<section id="contacto" class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Contacto Directo</span>
      <h2 class="section-title">Hablemos de tu Próximo Proyecto</h2>
      <p class="section-description">
        ¿Tienes una oportunidad laboral, consulta freelance o propuesta de proyecto? Contáctame directamente a través de correo electrónico o redes profesionales.
      </p>
    </div>

    <div class="contact-direct-grid">
      <!-- Main Direct Email Box -->
      <div class="direct-email-card glass-card">
        <div class="email-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h3>Correo Electrónico Principal</h3>
        <p class="email-text">{PROFILE_CONFIG.personal.email}</p>
        <p class="email-subtext">Respondo habitualmente en menos de 24 horas.</p>

        <a href={`mailto:${PROFILE_CONFIG.personal.email}?subject=Contacto%20Portafolio%20-%20Franco%20Borotto`} class="btn btn-primary btn-email">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Enviar Correo Directo (Gmail)
        </a>
      </div>

      <!-- Quick Contact Channels -->
      <div class="contact-channels glass-card">
        <h3 class="channels-title">Otros Canales de Contacto</h3>
        
        <div class="channels-list">
          <a href={`tel:${PROFILE_CONFIG.personal.phone.replace(/\s+/g, '')}`} class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="channel-label">Teléfono / WhatsApp</span>
              <span class="channel-val">{PROFILE_CONFIG.personal.phone}</span>
            </div>
          </a>

          <a href={PROFILE_CONFIG.personal.linkedin} target="_blank" rel="noopener noreferrer" class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </div>
            <div>
              <span class="channel-label">LinkedIn</span>
              <span class="channel-val">linkedin.com/in/francoborottovidal</span>
            </div>
          </a>

          <a href={PROFILE_CONFIG.personal.github} target="_blank" rel="noopener noreferrer" class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </div>
            <div>
              <span class="channel-label">GitHub</span>
              <span class="channel-val">github.com/Frank9015</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-direct-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .direct-email-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 2rem;
    background: radial-gradient(circle at top, rgba(99, 102, 241, 0.12), rgba(15, 23, 42, 0.6));
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .email-badge {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
    border: 1px solid rgba(129, 140, 248, 0.3);
    color: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .direct-email-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .email-text {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cyan-light);
    font-family: var(--font-mono);
    margin-bottom: 0.4rem;
  }

  .email-subtext {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .btn-email {
    width: 100%;
    max-width: 320px;
    justify-content: center;
  }

  .channels-title {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
    text-decoration: none;
  }

  .channel-item:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--border-glow);
    transform: translateX(4px);
  }

  .channel-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(6, 182, 212, 0.15);
    color: var(--cyan-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .channel-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  @media (max-width: 868px) {
    .contact-direct-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
